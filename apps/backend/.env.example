# PostgreSQL (Supabase) — pooled connection for app runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# PostgreSQL (Supabase) — direct connection for Prisma migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT signing (recruiter auth — not Supabase Auth)
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN="7d"

# Supabase project
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Redis (Bull queue — e.g. Upstash)
REDIS_URL="redis://default:[password]@[host]:[port]"

# OpenAI (backend proxy / orchestration)
OPENAI_API_KEY="sk-..."

# ML scoring service
ML_SERVICE_URL="http://localhost:8100"
